/* 首页文章列表简洁模式 - 只显示标题和日期 */

/* 隐藏首页文章摘要内容 */
.home .post-body {
  display: none;
}

/* 隐藏"阅读全文"按钮 */
.home .post-button {
  display: none;
}

/* 优化文章标题样式 */
.home .post-title {
  margin-bottom: 0.5em;
}

/* 优化元信息样式（日期、分类等） */
.home .post-meta {
  margin-bottom: 1.5em;
  padding-bottom: 1em;
  border-bottom: 1px solid #eee;
}

/* 调整文章间距 */
.home .post {
  margin-bottom: 1.5em;
  padding-bottom: 0;
}

/* 可选：鼠标悬停效果 */
.home .post-title a:hover {
  color: #fc6423;
}